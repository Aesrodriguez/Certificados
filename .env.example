# Entorno: development | production
ENV=development

# Supabase — pooler en modo transacción (puerto 6543) para la app (async, asyncpg)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?ssl=require

# Supabase — conexión directa, sin pooler (usada solo por Alembic desde local, driver sync).
# Opcional: si falta, Alembic usa DATABASE_URL. En Vercel no hace falta.
DATABASE_URL_DIRECT=postgresql+psycopg2://USER:PASSWORD@db.PROYECTO.supabase.co:5432/postgres?sslmode=require

# Secreto usado para firmar tokens CSRF y otros propósitos internos.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# Nombre de la cookie de sesión
SESSION_COOKIE_NAME=clara_session

# Duración de la sesión en minutos
SESSION_LIFETIME_MINUTES=720

# Correo: Gmail API (OAuth2). Obtener el refresh token con scripts/get_gmail_token.py
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Firma del certificado
FIRMA_NOMBRE=
FIRMA_CARGO="Administrador de Ciudad"

# Datos para el script de bootstrap del primer Admin (scripts/seed_admin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
