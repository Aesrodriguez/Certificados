{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "excludeFiles": "{tests/**,scripts/**,.venv/**,Dockerfile,render.yaml,start.sh}" }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }]
}
