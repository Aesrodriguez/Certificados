{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["pdx1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,scripts/**,migrations/**,.venv/**,Docs/**,Contexto/**,**/__pycache__/**,alembic.ini,README.md}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
